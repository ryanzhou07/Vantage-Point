# Local-only examples; no generated keys or credentials are committed.
API_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# Local public anon key from Supabase status; this key is safe for browser use.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend process only; never copy privileged values into NEXT_PUBLIC_* variables.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=
WEB_ORIGIN=http://localhost:3000
# No privileged key is required by Foundation auth/profile routes.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Optional: split session lifetime, 1m-60m (default 5m)
SPLIT_SESSION_TTL=5m
